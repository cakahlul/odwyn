ODWYN_USER=owner
ODWYN_PASSWORD=
PORT=4317
# Public HTTPS tunnel URL, required for remote browser requests.
ODWYN_ORIGIN=
# Initial provider defaults. Later changes are saved through Settings.
# ODWYN_PROVIDER=codex
# Defaults to ./data/codex. Sign in under this home for Codex.
# ODWYN_CODEX_HOME=/absolute/path/to/dedicated/codex-home
# ODWYN_MODEL=gpt-6.1-sol
# Claude defaults to sonnet; OpenAI-compatible APIs require a model name.
# ODWYN_CLAUDE_COMMAND=/absolute/path/to/claude
# ODWYN_API_BASE_URL=https://api.openai.com/v1
# ODWYN_API_KEY=
# Codex reasoning effort is medium for every task and follow-up.
# ODWYN_BROWSER_EXECUTABLE=/usr/bin/chromium
# ODWYN_HEADLESS=true
